<% if params[:short] == 'true' %>
  <%= turbo_frame_tag dom_id(@subscription) do %>
    <%= render partial: 'subscriptions/subscription_row', locals: { subscription: @subscription } %>
  <% end %>

<% elsif !turbo_frame_request? %>
  <header class="contaner">
    <h2>Show subscription</h2>
  </header>

  <%= turbo_frame_tag dom_id(@subscription) do %>
    <%= render partial: 'subscriptions/subscription_detail', locals: { subscription: @subscription } %>
  <% end %>

<% else %>
  <%= render partial: 'subscriptions/success_modal', locals: {
    subscription: @subscription,
    heading: 'Updated subscription',
    message: notice,
    run_create_flow: false,
  } %>
<% end %>

<hr>

<p>
  <%= link_to "Refresh subscription", refresh_feed_subscription_path(@subscription), data: { turbo_method: :patch, turbo_frame: dom_id(@subscription) } %> |
  <%= link_to "articles of this subscription", subscription_articles_path(@subscription) %>
</p>

<hr>

<div class="contaner">
  <%= link_to "Edit this subscription", edit_subscription_path(@subscription) %> |
  <%= link_to "Back to subscriptions", subscriptions_path %>
</div>
