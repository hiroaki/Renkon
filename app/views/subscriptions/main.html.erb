<div class="flex flex-col h-screen text-gray-700"
  data-controller="pane-focus"
  data-action="
    changeReadStatus->pane-focus#onChangeReadStatus
    emptyTrash->pane-focus#onEmptyTrash
    connectedSelectedLiBaseController->pane-focus#onConnectedSelectedLiBaseController
    renkon:status-error@window->pane-focus#onStatusError
    renkon:subscriptions-refreshed@window->pane-focus#onSubscriptionsRefreshed
  "
  data-pane-focus-subscriptions-outlet='[data-controller~="subscriptions"]'
  data-pane-focus-articles-outlet='[data-controller~="articles"]'
>
  <nav class="shrink-0 h-12 bg-gray-200 px-1 flex flex-row place-items-center"
    data-pane-focus-target="navigationPane",
  >
    <%= image_tag('renkon.png', size: '46x46') %>

    <div class="ml-1 mr-2 max-w-20">
      <h2 class="m-0 p-0 my-0 text-gray-400">
        <span>Renkon</span>
      </h2>
    </div>

    <div class="mx-2">
      <button class="px-3 py-1 text-sm font-medium leading-5 text-white transition-colors duration-150 bg-blue-600 border border-transparent rounded-md active:bg-blue-600 hover:bg-blue-700 focus:outline-hidden focus:shadow-outline-blue"
        data-controller="refresh"
        data-action="click->refresh#all"
        data-refresh-concurrency-value="2"
        title="Refresh"
      >
        <%= icon_refresh(class: 'size-6') %>
      </button>
    </div>

    <div class="mx-2">
      <%=
        link_to(new_subscription_path,
          'data-turbo-frame' => 'modal',
          'data-pane-focus-target' => 'linkNewSubscription',
          'data-base-href' => new_subscription_path,
          'class' => 'px-3 py-1 text-sm font-medium leading-5 text-white transition-colors duration-150 bg-green-600 border border-transparent rounded-md active:bg-green-600 hover:bg-green-700 focus:outline-hidden focus:shadow-outline-green inline-flex items-center hover:text-white',
          'title' => 'New subscription',
        ) do
      %>
        <%= icon_new_subscription(class: 'size-6') %>
      <% end %>
    </div>
    <div class="mx-2">
      <%=
        link_to('#',
          'data-turbo-frame' => 'modal',
          'data-pane-focus-target' => 'linkEditSubscription',
          'class' => 'px-3 py-1 text-sm font-medium leading-5 text-white transition-colors duration-150 bg-green-600 border border-transparent rounded-md active:bg-green-600 hover:bg-green-700 focus:outline-hidden focus:shadow-outline-green inline-flex items-center hover:text-white data-[disabled=true]:bg-gray-400',
          'title' => 'Edit subscription',
        ) do
      %>
        <%= icon_edit_subscription(class: 'size-6') %>
      <% end %>
    </div>

    <div class="mx-2">
      <%=
        link_to(new_group_path,
          'data-turbo-frame' => 'modal',
          'data-pane-focus-target' => 'linkNewGroup',
          'data-base-href' => new_group_path,
          'class' => 'px-3 py-1 text-sm font-medium leading-5 text-white transition-colors duration-150 bg-green-600 border border-transparent rounded-md active:bg-green-600 hover:bg-green-700 focus:outline-hidden focus:shadow-outline-green inline-flex items-center hover:text-white',
          'title' => 'New group',
        ) do
      %>
        <%= icon_new_group(class: 'size-6') %>
      <% end %>
    </div>

    <div class="mx-2">
      <%=
        link_to('#',
          'data-turbo-frame' => 'modal',
          'data-pane-focus-target' => 'linkEditGroup',
          'class' => 'px-3 py-1 text-sm font-medium leading-5 text-white transition-colors duration-150 bg-green-600 border border-transparent rounded-md active:bg-green-600 hover:bg-green-700 focus:outline-hidden focus:shadow-outline-green inline-flex items-center hover:text-white data-[disabled=true]:bg-gray-400',
          'title' => 'Edit group',
        ) do
      %>
        <%= icon_edit_group(class: 'size-6') %>
      <% end %>
    </div>

    <div class="mx-2">
      <button class="px-3 py-1 text-sm font-medium leading-5 text-white transition-colors duration-150 bg-indigo-600 border border-transparent rounded-md active:bg-indigo-600 hover:bg-indigo-700 focus:outline-hidden focus:shadow-outline-indigo disabled:bg-gray-400 disabled:cursor-not-allowed"
        data-pane-focus-target="buttonMarkSelectedRead"
        data-action="click->pane-focus#markSelectedArticlesRead"
        title="Mark selected articles read (r toggles selected items)"
        disabled
        title="Mark Read"
      >
        <%= icon_mark_read(class: 'size-6') %>
      </button>
    </div>

    <div class="mx-2">
      <button class="px-3 py-1 text-sm font-medium leading-5 text-white transition-colors duration-150 bg-indigo-600 border border-transparent rounded-md active:bg-indigo-600 hover:bg-indigo-700 focus:outline-hidden focus:shadow-outline-indigo disabled:bg-gray-400 disabled:cursor-not-allowed"
        data-pane-focus-target="buttonMarkSelectedUnread"
        data-action="click->pane-focus#markSelectedArticlesUnread"
        title="Mark selected articles unread (u)"
        disabled
        title="Mark Unread"
      >
        <%= icon_mark_unread(class: 'size-6') %>
      </button>
    </div>

    <div class="mx-2">
      <button class="px-3 py-1 text-sm font-medium leading-5 text-white transition-colors duration-150 bg-orange-300 border border-transparent rounded-md active:bg-orange-300 hover:bg-orange-400 focus:outline-hidden focus:shadow-outline-orange"
        data-controller="trash"
        data-action="
          click->trash#confirmEmptyTrash
          click->trash#emptyTrash
        "
        data-url-empty-trash="<%= trash_path %>"
        data-text-for-confirm-empty-trash="Are you sure you want to empty the trash?"
        title="Empty Trash"
      >
        <%= icon_trash(class: 'size-6') %>
      </button>
    </div>
  </nav>

  <main class="flex flex-row flex-1 overflow-hidden">
    <div id="subscription-create-flow-hook"></div>

    <!-- -->
    <div id="subscriptions-pane" tabindex="-1" class="flex flex-row shrink-0 min-w-8 focus:outline-hidden" style="width: 8rem;"
      data-controller="frame"
      data-frame-target="adjustable"
      data-frame-storage-key-value="subscriptions-width"
      data-pane-focus-target="subscriptionsPane"
      data-action="
        keydown.right->pane-focus#forwardToArticlesPane
        keydown.space->pane-focus#forwardToUnreadArticlePane:prevent
        changeSelectedLi->pane-focus#onChangeSelectedSubscriptionListItem
      "
    >
      <div class="flex-1 bg-blue-100 overflow-y-auto overflow-x-hidden pt-2">
        <%= turbo_frame_tag('subscriptions', src: list_subscriptions_path) %>
      </div>
      <div class="w-0.5 bg-gray-200 cursor-col-resize" draggable="true"
        data-action="
          dragstart->frame#handlerDragStart
          drag->frame#handlerDrag
          dragend->frame#handlerDragEnd
        "
      >
      </div>
    </div>

    <!-- -->
    <div id="articles-pane" tabindex="-1" class="flex flex-row shrink-0 min-w-8 focus:outline-hidden" style="width: 8rem;"
      data-controller="frame"
      data-frame-target="adjustable"
      data-frame-storage-key-value="articles-width"
      data-pane-focus-target="articlesPane"
      data-action="
        keydown.left->pane-focus#backToSubscriptionsPane
        keydown.space->pane-focus#forwardContentsOrNextArticle:prevent
        changeSelectedLi->pane-focus#onChangeSelectedArticleListItems
      "
    >
      <div class="flex-1 bg-white-100 overflow-y-auto overflow-x-hidden pt-2">
        <%= turbo_frame_tag('articles') %>
      </div>
      <div class="w-0.5 bg-gray-200 cursor-col-resize" draggable="true"
      data-action="
        dragstart->frame#handlerDragStart
        drag->frame#handlerDrag
        dragend->frame#handlerDragEnd
      "
      >
      </div>
    </div>

    <!-- -->
    <div id="contents-pane" tabindex="-1" class="flex-1 overflow-y-auto min-w-8 focus:outline-hidden"
      data-pane-focus-target="contentsPane"
    >
      <div class="bg-white p-2">
        <%= turbo_frame_tag('contents', autoscroll: true, data: { autoscroll_block: 'start' } ) %>
      </div>
      <div class="w-0.5 bg-gray-200 cursor-col-resize">
      </div>
    </div>
  </main>

  <footer class="shrink-0 h-6 bg-gray-200 text-xs px-2 flex items-center">
    <p
      class="hidden items-center gap-1 text-red-700"
      data-pane-focus-target="statusArea"
      role="status"
      aria-live="polite"
    >
      <span aria-hidden="true">!</span>
      <span data-pane-focus-target="statusText"></span>
      <button
        type="button"
        class="ml-2 text-red-700 hover:text-red-900"
        data-action="click->pane-focus#clearStatusMessage"
        aria-label="Clear status message"
      >
        x
      </button>
    </p>
    <p data-pane-focus-target="statusIdle">Status</p>
  </footer>
</div>
