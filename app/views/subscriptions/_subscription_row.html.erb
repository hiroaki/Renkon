<div class="relative w-full">
  <div class="flex justify-between">
    <span class="left text-nowrap overflow-hidden">
      <% if subscription.favicon.attached? %>
        <%= image_tag subscription.favicon, width: 16, height: 16, class: 'inline' %>
        <%= subscription.title %>
      <% else %>
        <%= default_favicon %>
        <%= subscription.title %>
      <% end %>
    </span>
    <% unread_count = subscription.attributes.fetch('count_articles').to_i %>
    <%= content_tag :span,
      unread_count > 0 ? unread_count : 0,
      data: { refresh_badge: true, unread_count: unread_count },
      class: (unread_count > 0 ? "" : "invisible ") + "right ml-2 px-2 py-1 font-semibold leading-none rounded-full bg-green-100 text-green-700 dark:bg-green-700 dark:text-green-100"
    %>
  </div>
</div>
