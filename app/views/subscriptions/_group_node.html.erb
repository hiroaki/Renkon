<li tabindex="0" class="container focus:outline-none"
  data-item-type="group"
  data-group-id="<%= group.id %>"
  data-subscriptions-target="listItem"
  data-url-destroy="<%= group_path(group) %>"
  data-text-for-confirm-destroy="Delete this group and all nested groups/subscriptions?<%= "\n#{group.name}" %>"
>
  <div
    tabindex="-1"
    class="pl-2 pr-1 py-0.5 block text-xs font-semibold text-gray-500 cursor-pointer"
    data-action="click->subscriptions#handlerEnterItem"
  ><%= group.name %></div>

  <ul class="ml-2 min-h-3" data-tree-sort-list>
    <% group_nodes = (groups_by_parent_id[group.id] || []).map { |item| { item_type: 'group', item: item, position: item.position } } %>
    <% subscription_nodes = (subscriptions_by_group[group.id] || []).map { |item| { item_type: 'subscription', item: item, position: item.position } } %>
    <% (group_nodes + subscription_nodes).sort_by { |node| [node[:position], node[:item].id] }.each do |node| %>
      <% if node[:item_type] == 'group' %>
        <%= render partial: 'subscriptions/group_node', locals: {
          group: node[:item],
          groups_by_parent_id: groups_by_parent_id,
          subscriptions_by_group: subscriptions_by_group,
        } %>
      <% else %>
        <%= render partial: 'subscriptions/subscription_node', locals: { subscription: node[:item] } %>
      <% end %>
    <% end %>
  </ul>
</li>
