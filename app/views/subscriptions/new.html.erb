<% form = capture { render "form", subscription: @subscription, insert_context_type: @insert_context_type, insert_context_id: @insert_context_id } %>

<% unless turbo_frame_request? %>
  <h2>New subscription</h2>

  <%= form %>
<% else %>
  <%= render('shared/modal_frame', heading: 'New subscription') do %>
    <%= form %>
  <% end %>
<% end %>

<hr>

<div class="contaner">
  <%= link_to "Back to subscriptions", subscriptions_path %>
</div>
