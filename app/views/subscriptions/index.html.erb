<header class="contaner">
  <h2>Subscriptions</h2>
</header>

<nav class="container">
  <%= link_to 'New subscription', new_subscription_path, 'data-turbo-frame' => turbo_frame_if_turbo_frame_request('modal') %>
  |
  <%= link_to 'New group', new_group_path, 'data-turbo-frame' => turbo_frame_if_turbo_frame_request('modal') %>
</nav>

<hr>

<%= turbo_frame_tag 'subscriptions' do %>
<div class="flex flex-col h-full">
  <ul class="container h-full select-none" tabindex="-1" data-controller="subscriptions subscriptions-tree-sort"
    data-subscriptions-tree-sort-url-value="<%= reorder_tree_subscriptions_path %>"
    data-action="
      keydown.enter->subscriptions#openUrl
      dblclick->subscriptions#openUrl
      keydown.backspace->subscriptions#confirmDestroy
      keydown.backspace->subscriptions#destroySelectedItem
      keydown.delete->subscriptions#confirmDestroy
      keydown.delete->subscriptions#destroySelectedItem

      keydown.up->subscriptions#selectPrevItem:prevent
      keydown.down->subscriptions#selectNextItem:prevent
    "
  >
    <li id="trash" tabindex="0" class="container focus:outline-hidden"
      data-item-type="trash"
      data-subscriptions-target="listItem"
    >
      <div class="container overflow-hidden text-nowrap text-xs">
        <span
          tabindex="-1"
          class="pl-2 pr-1 py-0.5 block no-underline text-inherit hover:no-underline hover:text-inherit cursor-pointer"
          data-turbo-frame="<%= turbo_frame_if_turbo_frame_request('articles') %>"
          data-action="click->subscriptions#handlerEnterItem"
          data-link-to-url="<%= trash_path %>"
          data-link-to-frame="articles"
        >
          <div class="relative w-full">
            <div class="flex justify-between">
              <span class="left text-nowrap overflow-hidden ">
                <%= svg_trash %>
                Trash
              </span>
              <span class="right ml-2 px-2 py-1 font-semibold leading-none">
                &nbsp;
              </span>
            </div>
          </div>
        </span>
      </div>
    </li>

    <% root_group_nodes = @root_groups.map { |item| { item_type: 'group', item: item, position: item.position } } %>
    <% root_subscription_nodes = @top_level_subscriptions.map { |item| { item_type: 'subscription', item: item, position: item.position } } %>
    <% (root_group_nodes + root_subscription_nodes).sort_by { |node| [node[:position], node[:item].id] }.each do |node| %>
      <% if node[:item_type] == 'group' %>
        <%= render partial: 'subscriptions/group_node', locals: {
          group: node[:item],
          groups_by_parent_id: @groups_by_parent_id,
          subscriptions_by_group: @subscriptions_by_group,
        } %>
      <% else %>
        <%= render partial: 'subscriptions/subscription_node', locals: { subscription: node[:item] } %>
      <% end %>
    <% end %>
  </ul>
</div>
<% end %>
