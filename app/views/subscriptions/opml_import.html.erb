<%= render('shared/modal_frame', heading: 'Import OPML', close_label: 'Close') do %>
  <% if flash.now[:alert].present? %>
    <p class="mb-3 text-sm text-red-700"><%= flash.now[:alert] %></p>
  <% end %>

  <% if @import_result.present? %>
    <div class="space-y-3 text-sm text-gray-700">
      <p class="font-semibold text-green-700">Import completed.</p>
      <ul class="list-disc pl-5">
        <li>Created subscriptions: <%= @import_result[:created_subscriptions] %></li>
        <li>Created groups: <%= @import_result[:created_groups] %></li>
        <li>Skipped subscriptions: <%= @import_result[:skipped_subscriptions] %></li>
        <li>Invalid subscriptions: <%= @import_result[:invalid_subscriptions] %></li>
      </ul>

      <div>
        <%= link_to 'Import another file', opml_import_subscriptions_path,
          class: 'inline-block px-3 py-1 text-sm leading-6 font-medium text-gray-700 bg-white border border-gray-200 rounded-md hover:border-gray-300',
          data: { turbo_frame: 'modal' } %>
      </div>
    </div>
  <% else %>
    <%= form_with url: opml_import_upload_subscriptions_path, method: :post, multipart: true, class: 'space-y-4' do |form| %>
      <div>
        <%= form.label :file, 'OPML file', class: 'block text-sm font-semibold text-gray-700 mb-1' %>
        <%= form.file_field :file, accept: '.opml,.xml,text/xml,application/xml', class: 'block w-full text-sm' %>
      </div>

      <div class="my-4">
        <%= form.submit 'Import', class: 'px-3 py-1 text-sm font-medium leading-5 text-white transition-colors duration-150 bg-blue-600 border border-transparent rounded-md active:bg-blue-600 hover:bg-blue-700 focus:outline-hidden focus:shadow-outline-blue' %>
      </div>
    <% end %>
  <% end %>
<% end %>
