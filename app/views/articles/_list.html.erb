<div class="flex flex-col h-full">
  <ul class="container select-none"
    data-controller="articles"
    data-articles-multi-select-value="true"
    data-action="
      keydown.enter->articles#openUrl
      keydown.enter->articles#handlerMakeItemRead

      keydown.backspace->articles#deleteSelectedItems:prevent
      keydown.delete->articles#deleteSelectedItems:prevent
      keydown.r->articles#toggleSelectedItemsReadStatus:prevent
      keydown.u->articles#markSelectedItemsUnread:prevent

      dblclick->articles#openUrl
      dblclick->articles#handlerMakeItemRead

      keydown.up->articles#selectPrevItem:prevent
      keydown.down->articles#selectNextItem:prevent
      keydown.shift+up->articles#selectPrevItem:prevent
      keydown.shift+down->articles#selectNextItem:prevent
    "
  >
    <% @articles.each do |article| %>
      <%= tag.li id: dom_id(article),
        tabindex: 0,
        class: 'container even:bg-gray-100 focus:outline-hidden',
        data: article_list_item_data(article) do %>
        <div class="container overflow-hidden text-nowrap text-xs">
            <div class="container flex flex-row text-xs">

              <button class="w-6 shrink-0 flex justify-center items-center cursor-pointer"
                data-action="
                  click->articles#handlerToggleReadStatus
                "
              >
                <%= article.unread? ? '●' : '　' %>
              </button>

              <div class="container grow">
                <span
                  tabindex="-1"
                  class="pl-2 pr-1 py-0.5 block no-underline text-inherit hover:no-underline hover:text-inherit focus:outline-hidden cursor-pointer"
                  data-turbo-frame="<%= turbo_frame_if_turbo_frame_request('contents') %>"
                  data-action="click->articles#handlerEnterItem"
                  data-link-to-url="<%= subscription_article_path(article.subscription, article) %>"
                  data-link-to-frame="contents"
                >
                  <p class="overflow-hidden text-nowrap">
                    <span><%= article.title %></span>
                  </p>
                  <p class="text-xs text-gray-400 overflow-hidden text-nowrap">
                    <%= article.pub_date %>
                  </p>
                </span>
              </div>

            </div>
        </div>
      <% end %>
    <% end %>
  </ul>
</div>
