#----------------------------------------
# APPLICATION SETTINGS
#

# To enable Basic Authentication, set ENABLED_BASIC_AUTH to 1.
# Set BASIC_AUTH_PAIRS with username and password pairs.
#ENABLED_BASIC_AUTH=1
#BASIC_AUTH_PAIRS=user1:password1,user2:password2,userN:passwordN

# Required in production and staging environments
# SECRET_KEY_BASE is used for encrypting sessions, cookies, and other sensitive data.
#
# Generate a new secret key using Rails:
#   bin/rails secret
#
# Example:
#   SECRET_KEY_BASE=abc123def456...
#
# IMPORTANT:
# - Use a different key for each environment (production, staging)
# - Keep these keys secure and never commit them to version control
# - The key should be 128 hexadecimal characters long
# - Once set, DO NOT change this key as it will invalidate all existing sessions and encrypted data
SECRET_KEY_BASE=


#----------------------------------------
# DEPLOY SETTINGS
#

# If DEPLOY_REGISTRY_SERVER is set, configure a remote Container Registry.
#DEPLOY_REGISTRY_SERVER=
#DEPLOY_REGISTRY_USERNAME=
#DEPLOY_REGISTRY_PASSWORD=
#
# If DEPLOY_REGISTRY_SERVER is not set, it defaults to localhost.
# In that case you may specify a port number (the default port is 5555).
#DEPLOY_REGISTRY_SERVER_PORT=5555

DEPLOY_IMAGE=

DEPLOY_SERVERS_WEB_HOSTS=

DEPLOY_SSH_PORT=
DEPLOY_SSH_USER=
DEPLOY_SSH_KEYS=

# The application's /rails/storage directory is mounted to the host directory
# specified by DEPLOY_VOLUMES_STORAGE. You must create this directory in advance
# and ensure that the deploy user (DEPLOY_SSH_USER) has write permissions.
DEPLOY_VOLUMES_STORAGE=

# When using a custom SSL certificate, the hostname set in proxy.host must match
# one of the Subject Alternative Names (SAN) listed in the certificate.
# If it does not match, SSL verification will fail during HTTPS connections.
# Note: Due to SNI (Server Name Indication) requirements, using an IP address
# in proxy.host may cause SSL verification to fail. Use a hostname instead.
DEPLOY_PROXY_HOST=
DEPLOY_PROXY_BUFFERING_MAX_REQUEST_BODY=10485760
